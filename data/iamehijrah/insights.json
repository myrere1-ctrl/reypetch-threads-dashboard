    },
    {
      "id": "17960742444172653",
      "text": "Habis Subuh tadi, duduk sebentar — dan tiba-tiba nyadar betapa seringnya aku ngerasa Allah \"salah timing\" ngasih sesuatu",
      "permalink": "https://www.threads.com/@_iame.hijrah/post/DbpxLJdFhpK",
